# Copy this file to `.env` in the repository root.
# Never commit the real `.env` file.

# Optional: only required to submit predictions to the AgentDS benchmark.
AGENTDS_API_KEY=
AGENTDS_TEAM_NAME=

# Directory containing the AgentDS-Healthcare task files.
CLAI_BASE_DIR=./data/AgentDS-Healthcare/Healthcare

# Optional override for the raw Challenge 2 receipt PDFs.
CLAI_RECEIPT_DIR=./data/AgentDS-Healthcare/Healthcare/receipts_pdf

# Optional experiment controls used by some archived notebooks.
CLAI_BRANCH=paper_release
FEATURE_CACHE_MODE=versioned
FORCE_RETRAIN=0
